{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rowhouse-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rowhouse",
      "database_id": "38b0face-bc86-4be0-8320-2dd7999cccd5",
      "migrations_dir": "migrations"
    }
  ],

  "kv_namespaces": [
    { "binding": "SESSIONS", "id": "5bd95dea00be4d55b1b2ae364c016807" },
    { "binding": "CONFIG", "id": "b17f435b605a4b7c808759d460e100fc" }
  ],

  // R2 is not enabled on the account yet, so the buckets are unbound and the
  // Worker serves everything except audio/fingerprint storage (503
  // storage_not_configured). To turn storage on: enable R2 in the dashboard,
  // `wrangler r2 bucket create` each bucket below, then uncomment and redeploy.
  // "r2_buckets": [
  //   { "binding": "AUDIO", "bucket_name": "rowhouse-audio" },
  //   { "binding": "FINGERPRINTS", "bucket_name": "rowhouse-fingerprints" },
  //   { "binding": "MEDIA", "bucket_name": "rowhouse-media" }
  // ],

  "durable_objects": {
    "bindings": [{ "name": "CHAT", "class_name": "ChatRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatRoom"] }],

  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "rowhouse-jobs" }],
    "consumers": [
      {
        "queue": "rowhouse-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 3,
        "dead_letter_queue": "rowhouse-jobs-dlq"
      }
    ]
  },

  "triggers": {
    // */15: process pending fingerprint/clip jobs. 0 3: nightly housekeeping.
    "crons": ["*/15 * * * *", "0 3 * * *"]
  },

  "vars": {
    "APP_ORIGIN": "https://rowhouse-gg.pages.dev",
    "PUBLIC_API_ORIGIN": "https://rowhouse-api.karthik-e5e.workers.dev",
    "VAPID_SUBJECT": "mailto:push@rowhouse.gg",
    "TMDB_IMAGE_BASE": "https://image.tmdb.org/t/p"
  }
  // Secrets (wrangler secret put): GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
  // SESSION_PEPPER, VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, TMDB_API_KEY, TMDB_READ_TOKEN
}
