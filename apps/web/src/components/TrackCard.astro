---
import { formatTimecode } from '@rowhouse/types';
interface Props {
  track: {
    id: string;
    title: string;
    filmSlug?: string;
    creatorHandle?: string;
    handle?: string;
    creatorName?: string;
    name?: string;
    durationSeconds: number;
    listenCount: number;
    isLiveReplay?: boolean;
    tone?: string | null;
  };
}
const { track } = Astro.props;
const handle = track.creatorHandle ?? track.handle ?? 'creator';
const creatorName = track.creatorName ?? track.name ?? handle;
---

<a
  href={`/track/${track.id}`}
  class="group flex min-w-0 w-full flex-wrap items-center gap-x-4 gap-y-1 rounded-lg border border-border bg-surface p-3 transition-colors hover:border-accent/40 sm:flex-nowrap"
>
  <div class="grid size-12 shrink-0 place-items-center rounded-md bg-surface-2 font-mono text-[10px] text-text-mid ring-1 ring-border">
    {formatTimecode(track.durationSeconds)}
  </div>
  <div class="min-w-0 flex-1 basis-[calc(100%-3.5rem)] sm:basis-auto">
    <div class="flex min-w-0 items-center gap-2">
      {track.isLiveReplay && (
        <span class="shrink-0 rounded bg-accent/15 px-1.5 py-0.5 font-mono text-[9px] uppercase tracking-wider text-accent-hi">Replay</span>
      )}
      <h3 class="min-w-0 truncate text-sm font-medium text-text-hi group-hover:text-white">{track.title}</h3>
    </div>
    <p class="mt-0.5 truncate text-xs text-text-mid">
      {creatorName} · <span class="font-mono text-text-dim">@{handle}</span>
    </p>
  </div>
  <span class="w-full pl-16 font-mono text-xs text-text-dim sm:w-auto sm:pl-0 sm:shrink-0">{track.listenCount.toLocaleString()} listens</span>
</a>
