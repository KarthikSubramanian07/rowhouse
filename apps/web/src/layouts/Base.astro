---
import '../styles/app.css';
import AuthNav from '../components/AuthNav';
import { organizationJsonLd } from '../lib/agent/jsonld';
import { SITE } from '../lib/agent/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string | undefined;
  canonical?: string | undefined;
  /** One JSON-LD object, or several; each renders as its own script block. */
  jsonLd?: unknown;
  /** When false, ask crawlers not to index (studio, 404, etc.). */
  index?: boolean;
}

const {
  title = 'Rowhouse: live commentary synced to whatever you’re watching',
  description = SITE.description,
  ogImage,
  canonical,
  jsonLd,
  index = true,
} = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://rowhouse-gg.pages.dev';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site).toString();
const resolvedOg = ogImage ?? `${site}/og.png`;
const robots = index ? 'index, follow, max-image-preview:large' : 'noindex, nofollow';
// The organization identifies the site on every page; page-specific nodes follow.
const jsonLdBlocks = [organizationJsonLd(), ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])];

/**
 * Serialize JSON-LD for a <script> context. JSON.stringify does not escape
 * `<`, so a `</script>` inside any user-controlled field (creator name, bio,
 * track title) would break out of the element. Escaping `<`, `>` and `&` to
 * their \\uXXXX forms keeps the JSON valid and makes script-context breakout
 * impossible.
 */
function serializeJsonLd(data: unknown): string {
  return JSON.stringify(data)
    .replace(/</g, '\\u003c')
    .replace(/>/g, '\\u003e')
    .replace(/&/g, '\\u0026');
}
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#0B0B0D" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Rowhouse" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={resolvedOg} />
    {!ogImage && <meta property="og:image:width" content="1536" />}
    {!ogImage && <meta property="og:image:height" content="1024" />}
    <meta property="og:image:alt" content="Rowhouse: commentary synced to your frame" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOg} />
    <meta name="twitter:image:alt" content="Rowhouse: commentary synced to your frame" />

    {jsonLdBlocks.map((block) => <script type="application/ld+json" set:html={serializeJsonLd(block)} />)}
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%230B0B0D'/%3E%3Crect x='6' y='9' width='4' height='14' fill='%23E0362E'/%3E%3Crect x='14' y='9' width='4' height='14' fill='%23F2F0EC'/%3E%3Crect x='22' y='9' width='4' height='14' fill='%23F2F0EC'/%3E%3C/svg%3E" />
  </head>
  <body class="min-h-screen bg-bg text-text-hi">
    <header class="sticky top-0 z-40 border-b border-border/80 bg-bg/80 backdrop-blur">
      <div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-4 sm:px-6">
        <a href="/" class="flex items-center gap-2" aria-label="Rowhouse home">
          <span class="flex items-end gap-[3px]" aria-hidden="true">
            <span class="block h-4 w-[3px] bg-accent"></span>
            <span class="block h-4 w-[3px] bg-text-hi"></span>
            <span class="block h-4 w-[3px] bg-text-hi"></span>
          </span>
          <span class="font-display text-xl font-semibold tracking-tight">Rowhouse</span>
        </a>
        <nav class="flex items-center gap-1 text-sm" aria-label="Primary">
          <a href="/discover" class="rounded-md px-3 py-1.5 text-text-mid transition-colors hover:bg-surface hover:text-text-hi">Discover</a>
          <a href="/live" class="rounded-md px-3 py-1.5 text-text-mid transition-colors hover:bg-surface hover:text-text-hi">Live</a>
          <AuthNav client:load />
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="mt-24 border-t border-border/80">
      <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-10 text-sm text-text-dim sm:flex-row sm:items-center sm:justify-between sm:px-6">
        <div class="max-w-md">
          <p class="font-mono text-xs uppercase tracking-widest text-text-mid">Rowhouse</p>
          <p class="mt-1">Watch together. React live. Replay forever. We carry the commentary; the film stays on your platform of choice.</p>
        </div>
        <nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="Footer">
          <a href="/discover" class="hover:text-text-hi">Discover</a>
          <a href="/live" class="hover:text-text-hi">Live now</a>
          <a href="/about" class="hover:text-text-hi">How sync works</a>
          <a href="/contact" class="hover:text-text-hi">Contact</a>
          <a href="/privacy" class="hover:text-text-hi">Privacy</a>
          <a
            href="https://github.com/KarthikSubramanian07/rowhouse"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-text-hi">GitHub</a
          >
          <a
            href="https://buymeacoffee.com/winnerkarthik"
            target="_blank"
            rel="noopener noreferrer"
            class="text-accent hover:text-accent-hi">Buy me a coffee</a
          >
        </nav>
      </div>
    </footer>
  </body>
</html>
