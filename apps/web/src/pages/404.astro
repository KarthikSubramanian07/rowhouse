---
import Base from '../layouts/Base.astro';
---

<Base
  title="Lost the frame — Rowhouse"
  description="This page isn't here. Head back to the canon and pick a film."
>
  <section class="mx-auto flex max-w-3xl flex-col items-start px-4 pt-24 sm:px-6 sm:pt-32">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent-hi">404 · no sync found</p>
    <h1 class="mt-4 font-display text-6xl leading-[0.95] text-text-hi sm:text-7xl">
      This reel's missing.
    </h1>
    <p class="mt-5 max-w-lg text-lg text-text-mid">
      We held up the phone and heard nothing. Whatever was here got cut in the edit — or it never
      made the reel. Let's get you back to something playing.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="rounded-md bg-accent px-4 py-2.5 text-sm font-medium text-white transition-colors hover:bg-accent-hi">
        Back home
      </a>
      <a href="/discover" class="rounded-md border border-border px-4 py-2.5 text-sm text-text-mid transition-colors hover:border-text-mid hover:text-text-hi">
        Browse the canon
      </a>
    </div>
  </section>
</Base>
